## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
[Bb]uild/
[Ll]og/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Roslyn cache
*.ide/

# Visual Studio 2022/2025/2026
.vs/
*.psess
*.vsp
*.vspscc

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Backup files
*_i.c
*_p.c
*.tmp
*.temp
*.bak

# NuGet
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets

# Publish outputs
publish/
*.pubxml
*.publishproj

# Debug/Release folders
[Dd]ebug*/
[Rr]elease*/
[Rr]eleases*/

# Cache
*.cache
*.dbmdl
*.jfm

# Visual Studio Code workspace
.vscode/

# ReSharper
_ReSharper.*/
*.DotSettings.user

# Rider
.idea/
*.sln.iml

# Others
TestResults/
*.tlog
*.pdb
*.mdb

# Logs
*.log

# Generated files for WinForms Designer
*.resources

# Windows specific trash
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
